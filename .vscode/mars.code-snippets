{
  "MARS: Cover": {
    "prefix": "mars-cover",
    "body": [
      "<!-- _class: title-academic institutional-cover -->",
      "",
      "<img class=\"logo-ensak\" src=\"${1:../../../shared/branding/ensak-logo.png}\" alt=\"ENSA Khouribga\" />",
      "<img class=\"logo-usms\" src=\"${2:../../../shared/branding/usms-logo.png}\" alt=\"Université Sultan Moulay Slimane\" />",
      "",
      "<div class=\"cover-title-block\">",
      "<div class=\"title\">${3:Titre du cours}</div>",
      "<div class=\"subtitle\">${4:Sous-titre}</div>",
      "</div>",
      "",
      "<div class=\"cover-meta\">",
      "<div class=\"author\">${5:Hamza Khalfi}</div>",
      "<div class=\"date\">${6:Année universitaire 2026–2027}</div>",
      "<div class=\"organization\">École Nationale des Sciences Appliquées de Khouribga<br>Université Sultan Moulay Slimane</div>",
      "</div>"
    ],
    "description": "Couverture institutionnelle MARS"
  },
