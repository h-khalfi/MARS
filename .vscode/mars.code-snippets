  "MARS: Architecture": {
    "prefix": "mars-arch",
    "body": [
      "<!-- _class: architecture -->",
      "",
      "# ${1:Titre}",
      "",
      "<div class=\"architecture-canvas\">",
      "<div class=\"architecture-flow\">",
      "",
      "<div class=\"architecture-stage\"><strong>${2:Entrée}</strong>${3:Données}</div>",
      "<div class=\"architecture-arrow\">→</div>",
      "<div class=\"architecture-stage feature\"><strong>${4:Représentation}</strong>${5:Transformation}</div>",
      "<div class=\"architecture-arrow\">→</div>",
      "<div class=\"architecture-stage learned\"><strong>${6:Bloc appris}</strong>${7:Traitement}</div>",
      "<div class=\"architecture-arrow\">→</div>",
      "<div class=\"architecture-stage output\"><strong>${8:Sortie}</strong>${9:Prédiction}</div>",
      "",
      "</div>",
      "</div>",
      "",
      "<div class=\"architecture-note\">${10:Note ou interprétation}</div>"
    ]
  },
  "MARS: Algorithm": {
    "prefix": "mars-algo",
    "body": [
      "<!-- _class: algorithm -->",
      "",
      "# ${1:Titre}",
      "",
      "<div class=\"algorithm-box\">",
      "",
      "<div class=\"algorithm-meta\">",
      "<div><strong>Entrée :</strong> ${2:données}</div>",
      "<div><strong>Sortie :</strong> ${3:résultat}</div>",
      "</div>",
      "",
      "1. ${4:Initialiser}",
      "2. ${5:Calculer}",
      "3. ${6:Mettre à jour}",
      "",
      "<div class=\"algorithm-update\">",
      "",
      "$$",
      "${7:\\theta \\leftarrow \\theta - \\eta \\nabla_\\theta L}",
      "$$",
      "",
      "</div>",
      "",
      "</div>",
      "",
      "<div class=\"algorithm-note\">${8:Remarque sur convergence, complexité ou usage}</div>"
    ]
  },
  "MARS: Math derivation": {
    "prefix": "mars-derive",
    "body": [
