      "",
      "${2:Contenu...}",
      "",
      "</div>",
      "",
      "<div class=\"slide-visual\">",
      "",
      "![${3:Description}](${4:assets/image.png})",
      "",
      "<div class=\"caption\">${5:Légende}</div>",
      "",
      "</div>",
      "",
      "</div>"
    ]
  },
