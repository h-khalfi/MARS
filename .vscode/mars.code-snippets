  "MARS: Diagram": {
    "prefix": "mars-diagram",
    "body": [
      "<!-- _class: diagram -->",
      "",
      "# ${1:Titre}",
      "",
      "<div class=\"diagram-intro\">${2:Introduction courte}</div>",
      "",
      "<div class=\"diagram-flow\">",
      "",
      "<div class=\"diagram-node\">",
      "<div class=\"diagram-label\">${3:Entrée}</div>",
      "${4:Étape A}",
      "</div>",
      "",
      "<div class=\"diagram-arrow\">→</div>",
      "",
      "<div class=\"diagram-node\">",
      "<div class=\"diagram-label\">${5:Transformation}</div>",
      "${6:Étape B}",
      "</div>",
      "",
      "<div class=\"diagram-arrow\">→</div>",
      "",
      "<div class=\"diagram-node learned\">",
      "<div class=\"diagram-label learned\">${7:Appris}</div>",
      "${8:Étape C}",
      "</div>",
      "",
      "</div>",
      "",
      "<div class=\"diagram-takeaway\">${9:Message essentiel}</div>"
    ]
  },
  "MARS: Figure full": {
    "prefix": "mars-fig-full",
    "body": [
      "<!-- _class: figure-full -->",
      "",
      "# ${1:Titre}",
      "",
      "<div class=\"full-figure\">",
      "",
      "![${2:Description}](${3:assets/image.png})",
      "",
      "</div>",
      "",
      "<div class=\"caption\">${4:Légende}</div>"
    ]
  },
  "MARS: Equation focus": {
    "prefix": "mars-equation",
    "body": [
      "<!-- _class: equation-focus -->",
      "",
      "# ${1:Titre}",
      "",
      "<div class=\"main-equation\">",
      "",
      "$$",
      "${2:y = \\sigma(Wx+b)}",
      "$$",
      "",
      "</div>",
      "",
      "<div class=\"equation-notes\">",
      "",
      "<div class=\"equation-note\"><span class=\"equation-symbol\">W</span><span>${3:poids}</span></div>",
      "<div class=\"equation-note\"><span class=\"equation-symbol\">b</span><span>${4:biais}</span></div>",
      "<div class=\"equation-note accent\"><span class=\"equation-symbol\">σ</span><span>${5:activation}</span></div>",
      "",
      "</div>"
    ]
  },
