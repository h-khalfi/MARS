      "<div class=\"derivation\">",
      "",
      "<div class=\"derivation-step\"><div class=\"derivation-index\">1</div><div class=\"derivation-body\">${2:Première étape}</div></div>",
      "<div class=\"derivation-step\"><div class=\"derivation-index\">2</div><div class=\"derivation-body\">${3:Deuxième étape}</div></div>",
      "<div class=\"derivation-step\"><div class=\"derivation-index\">3</div><div class=\"derivation-body\">${4:Troisième étape}</div></div>",
      "<div class=\"derivation-conclusion\">${5:Conclusion}</div>",
      "",
      "</div>"
    ]
  },
